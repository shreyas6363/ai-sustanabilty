# Database configuration (SQLite for local development, migratable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT signing and session security
AUTH_SECRET="ecopulse-ai-super-secret-key-32-chars-minimum-2025"

# Google Gemini API key (optional - system operates transparently in Rule-Based Fallback mode if unset)
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"
